# Endpoint für die zu benchmarkenden Tools (gito.bot und pr-agent)
# OpenAI-kompatibler HTTP-Endpunkt; Default: an OpenAI-kompatibler Endpunkt für ein selbst gehostetes Modell (z.B. Qwen)
TOOL_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
TOOL_LLM_API_KEY=
# Exakter Model-Identifier — verifizieren mit:
#   curl $TOOL_LLM_BASE_URL/models -H "Authorization: Bearer $TOOL_LLM_API_KEY"
TOOL_LLM_MODEL=
# Context-Länge des Modells (aus derselben /v1/models-Antwort -> max_model_len).
# pr-agent kennt selbst gehostete Modelle nicht in seiner internen
# Token-Limit-Tabelle und bräuchte sonst diesen Wert explizit, sonst schlägt
# jeder Call mit "not defined in MAX_TOKENS" fehl.
TOOL_LLM_MAX_TOKENS=32768
# Sekunden, die pr-agent auf eine einzelne LLM-Antwort wartet, bevor es
# abbricht (litellm's eigener Timeout, unabhängig von unserem
# Subprozess-Timeout). Große PRs können auf einem ausgelasteten
# Self-Hosted-Endpunkt mehrere Minuten pro Call brauchen — Default 1200s (20 min).
TOOL_LLM_AI_TIMEOUT=1200

# Judge — bewertet ob zwei Findings denselben Defekt beschreiben.
# Muss anderer Anbieter/Endpoint als TOOL_LLM sein (Vermeidung Self-Judging-Bias).
# Provider-Auswahl: anthropic | openai
JUDGE_LLM_PROVIDER=anthropic
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=claude-sonnet-4-5
# JUDGE_LLM_BASE_URL:
#   - openai: Pflicht (z.B. https://api.openai.com/v1)
#   - anthropic: optional — leer lassen für api.anthropic.com; setzen für
#     Anthropic-kompatible Proxies wie haex-claude-proxy (Claude Pro/Max-Sub
#     über OAuth statt API-Credits), z.B. http://localhost:8123
JUDGE_LLM_BASE_URL=

# GitHub — für CR-Kommentar-Scrape und pr-agent's eigenen GitHub-Zugriff.
# Wenn `gh auth status` grün ist, wird meistens kein separater Token gebraucht.
GH_TOKEN=

# Run Engine — PostgreSQL-Katalog (Pläne/Attempts/Scores) und S3-kompatibler
# Artifact-Store. Lokal: `docker compose up -d postgres rustfs`.
RUNENGINE_DATABASE_URL=postgresql://benchmark:benchmark@localhost:5433/runengine
RUNENGINE_S3_ENDPOINT_URL=http://localhost:9010
RUNENGINE_S3_BUCKET=runengine-artifacts
RUNENGINE_S3_ACCESS_KEY=benchmark
RUNENGINE_S3_SECRET_KEY=benchmark123
# Modell für die Bewertung von Findings außerhalb der Gold-Labels (FR-009a).
# Fällt auf JUDGE_LLM_MODEL zurück, wenn leer.
NOVEL_DEFECT_JUDGE_MODEL=

# Logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
