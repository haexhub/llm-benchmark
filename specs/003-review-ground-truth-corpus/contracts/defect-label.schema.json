{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtectedDefectLabel",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "severity", "affected_scope", "impact", "reproducer_id", "approval"],
  "properties": {
    "id": {"type": "string", "pattern": "^def-[a-z0-9-]{3,60}$"},
    "category": {"enum": ["correctness", "security", "performance", "error_handling", "testing", "configuration"]},
    "severity": {"enum": ["critical", "major", "minor"]},
    "affected_scope": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string"}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}}}},
    "impact": {"type": "string", "minLength": 1},
    "reproducer_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_count", "state"],
      "properties": {
        "reviewer_count": {"type": "integer", "minimum": 0},
        "state": {"enum": ["pending", "self_reviewed", "approved", "adjudicated"]},
        "curator_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "pending"}}},
          "then": {"properties": {"reviewer_count": {"const": 0}}}
        },
        {
          "if": {"properties": {"state": {"const": "self_reviewed"}}},
          "then": {
            "required": ["curator_id", "reviewed_at", "evidence_digest"],
            "properties": {"reviewer_count": {"const": 1}}
          }
        }
      ]
    }
  }
}
